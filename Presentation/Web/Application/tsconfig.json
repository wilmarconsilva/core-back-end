{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native"
  },
  "include": [
    "*.ts",
    "*.tsx",
    "Application/**/*.ts",
    "Application/**/*.tsx",
    "Configuration/**/*.ts",
    "Presentation/**/*.ts",
    "Presentation/**/*.tsx",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "bin", "obj"]
}
