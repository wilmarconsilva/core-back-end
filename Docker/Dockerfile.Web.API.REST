# syntax=docker/dockerfile:1

# ============================================
# Etapa 1: Build
# ============================================

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

# Copia os arquivos de projeto primeiro para aproveitar o cache
COPY Domain/Domain.csproj Domain/
COPY Application/Application.csproj Application/
COPY Infrastructure/Infrastructure.csproj Infrastructure/
COPY Presentation/Web/APIs/REST/REST.csproj Presentation/Web/APIs/REST/

# Restaura as dependências
RUN dotnet restore Presentation/Web/APIs/REST/REST.csproj

# Copia o código-fonte
COPY Domain/ Domain/
COPY Application/ Application/
COPY Infrastructure/ Infrastructure/
COPY Presentation/ Presentation/

# Compila e publica
RUN dotnet publish Presentation/Web/APIs/REST/REST.csproj \
    --configuration Release \
    --output /app/publish \
    --no-restore


# ============================================
# Etapa 2: Runtime
# ============================================

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final

WORKDIR /app

# Configurações do ASP.NET Core
ENV ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_RUNNING_IN_CONTAINER=true

# curl para o HEALTHCHECK do compose: a imagem aspnet não traz curl nem wget, e sem ele o
# healthcheck falha com "executable file not found in $PATH", deixando o container unhealthy
# para sempre. Como o proxy declara depends_on: service_healthy, isso derruba o "up" inteiro.
# Precisa vir ANTES do USER app, porque o apt-get exige root.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Usuário não-root
USER app

# Copia os arquivos publicados
COPY --from=build /app/publish .

# Render fornece a variável PORT em runtime
ENTRYPOINT ["sh", "-c", "dotnet REST.dll --urls http://0.0.0.0:${PORT}"]