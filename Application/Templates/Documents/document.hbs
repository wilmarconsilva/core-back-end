<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8"/>
    <title>{{DocumentTitle}} #{{Id}}</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; color: #333; }
        h1 { border-bottom: 2px solid #333; padding-bottom: 10px; }
        .info p { margin: 4px 0; }
        table { width: 100%; border-collapse: collapse; margin-top: 24px; }
        th, td { border: 1px solid #ccc; padding: 8px 12px; text-align: left; }
        th { background-color: #f5f5f5; font-weight: bold; }
        td.right, th.right { text-align: right; }
        .totals { margin-top: 20px; text-align: right; }
        .totals p { margin: 4px 0; }
        .label { font-weight: bold; }
    </style>
</head>
<body>

    <h1>{{DocumentTitle}} #{{Id}}</h1>

    <div class="info">
        <p><span class="label">Cliente:</span> {{CustomerName}}</p>
        <p><span class="label">Documento:</span> {{CustomerDocument}}</p>
        <p><span class="label">Data:</span> {{CreationDateTime}}</p>

        {{#if BudgetId}}
        <p><span class="label">Orçamento de origem:</span> {{BudgetId}}</p>
        {{/if}}

        {{#if Observations}}
        <p><span class="label">Observações:</span> {{Observations}}</p>
        {{/if}}
    </div>

    <table>
        <thead>
            <tr>
                <th>Produto</th>
                <th class="right">Qtd.</th>
                <th class="right">Valor Unit.</th>
                <th class="right">Valor Total</th>
            </tr>
        </thead>
        <tbody>
            {{#each Products}}
            <tr>
                <td>{{Name}}</td>
                <td class="right">{{Quantity}}</td>
                <td class="right">R$ {{ValueUnit}}</td>
                <td class="right">R$ {{ValueTotal}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <div class="totals">
        <p><span class="label">Subtotal:</span> R$ {{ValueSubtotal}}</p>
        <p><span class="label">Total:</span> R$ {{ValueTotal}}</p>
    </div>

</body>
</html>