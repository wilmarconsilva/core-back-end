<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <title>Pedido #{{Id}}</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; color: #333; }
        h1 { border-bottom: 2px solid #333; padding-bottom: 10px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ccc; padding: 8px 12px; text-align: left; }
        th { background-color: #f5f5f5; }
        .totals { margin-top: 20px; text-align: right; }
        .label { font-weight: bold; }
    </style>
</head>
<body>
    <h1>Pedido #{{Id}}</h1>

    <p><span class="label">Cliente:</span> {{CustomerName}}</p>
    <p><span class="label">Documento:</span> {{CustomerDocument}}</p>
    <p><span class="label">Data:</span> {{CreationDateTime}}</p>

    {{#if BudgetId}}
    <p><span class="label">Orçamento de origem:</span> #{{BudgetId}}</p>
    {{/if}}

    {{#if Observations}}
    <p><span class="label">Observações:</span> {{Observations}}</p>
    {{/if}}

    <div class="totals">
        <p><span class="label">Subtotal:</span> R$ {{ValueSubtotal}}</p>
        <p><span class="label">Total:</span> R$ {{ValueTotal}}</p>
    </div>
</body>
</html>
