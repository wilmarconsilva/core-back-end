# Copie este arquivo para .env (na raiz do repositório) e preencha com os valores do seu ambiente.
# O .env é ignorado pelo git (.gitignore) — nunca commitar o arquivo com valores reais.
# Chaves usam "__" como separador de seção, convertido para ":" pelo DotNetEnv (mesma convenção do
# AddEnvironmentVariables do ASP.NET Core). Lido tanto pela API (Program.cs) quanto pelas migrations
# do EF Core (Infrastructure/Persistence/AppDbContextFactory.cs).

# Connection string do PostgreSQL.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=core;Username=postgres;Password=postgres

# Chave usada para assinar/validar os tokens JWT. Gere uma chave forte e única por ambiente (>= 32 caracteres).
Jwt__SigningKey=CHANGE-ME-WITH-A-STRONG-KEY-AT-LEAST-32-CHARS

# Credenciais do servidor SMTP usado para envio de e-mail.
Email__Enabled=true
Email__Host=localhost
Email__Port=1025
Email__SenderEmail=noreply@localhost
Email__SenderName=Core - Desenvolvimento
Email__Username=
Email__Password=
Email__EnableSsl=false